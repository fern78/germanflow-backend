[
  {
    "word": "und",
    "pos": "conj",
    "pos_title": "Konjunktion",
    "lang_code": "de",
    "lang": "Deutsch",
    "senses": [
      {
        "glosses": [
          "verbindet allgemein Satzteile und Sätze; kann Satzzeichen (Komma, Semikolon, Punkt, Doppelpunkt, Ausrufezeichen und Fragezeichen) ersetzen, ermöglicht Aufzählung, Beiordnung, Ergänzung, Summierung und Hinzufügung"
        ],
        "examples": [
          {
            "text": "Die Sonne scheint und es ist warm.",
            "bold_text_offsets": [
              [
                18,
                21
              ]
            ]
          }
        ],
        "sense_index": "1",
        "topics": [
          "grammar"
        ]
      },
      {
        "glosses": [
          "aufzählend, beiordnend"
        ],
        "examples": [
          {
            "text": "Acht und eins sind neun.",
            "bold_text_offsets": [
              [
                5,
                8
              ]
            ]
          },
          {
            "text": "Emil, Paul und auch Alfred waren da.",
            "bold_text_offsets": [
              [
                11,
                14
              ]
            ]
          },
          {
            "text": "Milch, Kaffee und ein Sahnetüpfelchen obenauf.",
