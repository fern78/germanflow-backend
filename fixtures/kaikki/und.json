              [
                14,
                17
              ]
            ]
          }
        ],
        "sense_index": "2"
      },
      {
        "glosses": [
          "knüpft an"
        ],
        "examples": [
          {
            "text": "Rufe immer von überall her an und du wirst dich wundern, wie hoch die Telefonrechnung ausfällt.",
