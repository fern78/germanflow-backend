              ]
            ]
          },
          {
            "text": "ironisch: Schlag doch zu!",
            "bold_text_offsets": [
              [
                0,
                9
              ],
              [
                17,
                21
              ]
            ]
          },
          {
            "text": "ironisch: Mach doch was du willst!",
            "bold_text_offsets": [
              [
                0,
                9
              ],
              [
                15,
                19
              ]
            ]
          }
        ],
        "sense_index": "2"
      },
